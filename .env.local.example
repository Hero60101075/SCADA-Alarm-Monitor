# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)

# ---------- ฝั่ง server เท่านั้น: ห้ามเติม NEXT_PUBLIC_ หน้าชื่อเด็ดขาด ----------

# URL ของโปรเจกต์ Supabase (ไม่ต้องมี /rest/v1) เช่น https://abcdefghijklmno.supabase.co
SUPABASE_URL=

# Service role key ใช้ได้ 2 แบบ
#  - แบบใหม่: ขึ้นต้นด้วย sb_secret_...
#  - แบบเดิม (legacy JWT): eyJhbGciOi... (role = service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Publishable key (sb_publishable_...) หรือ anon JWT — ใช้สำหรับ Login with Google (Supabase Auth)
# อยู่ใน Supabase → Settings → API Keys
SUPABASE_PUBLISHABLE_KEY=

# อีเมลที่ได้สิทธิ์ ADMIN (คั่นด้วย comma) — ดูหน้า /admin/visits ได้ คนอื่นทั้งหมดเป็น USER
ADMIN_EMAILS=

# รหัสผ่านสำหรับหน้า /test (ควรยาวอย่างน้อย 12 ตัวอักษร)
TEST_PAGE_PASSWORD=

# true = ใช้ข้อมูลจำลอง ไม่เชื่อมต่อ Supabase เลย (สำหรับทดสอบ UI)
USE_MOCK_DATA=false

# ---------- Auto test AI (npm run test:ai) — ใช้เฉพาะสคริปต์ทดสอบ ไม่ได้ใช้ในเว็บ ----------
# endpoint ของ bigbotagent (OpenAI-compatible) และ key
BIGBOT_API_URL=https://bigbotagent.com/api/v1/users/v1/chat/completions
BIGBOT_API_KEY=
# โมเดลที่ใช้ทดสอบ (ควรตรงกับใน Make)
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- ค่าสาธารณะ (ส่งไปที่เบราว์เซอร์ได้ ไม่ใช่ความลับ) ----------
# ถูกฝังตอน build: แก้แล้วต้องรีสตาร์ต dev server / build ใหม่

# URL รูป QR สำหรับแอดเพื่อน LINE OA (https://...)
NEXT_PUBLIC_LINE_OA_QR_URL=

# ลิงก์แอดเพื่อน LINE OA เช่น https://lin.ee/xxxxxxx
NEXT_PUBLIC_LINE_OA_ADD_URL=
